{
  "name": "dsh-waibao",
  "version": "0.1.3",
  "description": "Codex 与 DSH 桌面并行子任务、执行中交流、自由模型和连续上下文。",
  "type": "module",
  "main": "src/host.mjs",
  "exports": { ".": "./src/host.mjs", "./package.json": "./package.json", "./cordis.patch.yml": "./cordis.patch.yml" },
  "bin": { "dsh-waibao": "bin/cli.mjs", "dsh-waibao-job": "bin/job.mjs", "dsh-waibao-skill": "bin/install-skill.mjs" },
  "files": ["src", "bin", "skills", "docs", "promo/render.py", "promo/README.md", "promo/requirements.txt", "promo/assets", "cordis.patch.yml", "README.md", "LICENSE", "CHANGELOG.md"],
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "engines": { "node": ">=24" },
  "os": ["win32"],
  "keywords": ["dsh-plugin", "deepseek-harness", "codex", "delegation", "desktop"],
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/ericlee041769-hash/dsh-waibao.git" },
  "homepage": "https://github.com/ericlee041769-hash/dsh-waibao#readme",
  "bugs": { "url": "https://github.com/ericlee041769-hash/dsh-waibao/issues" },
  "scripts": { "test": "node --test", "check": "node --check src/host.mjs && node --check bin/cli.mjs && node --check bin/job.mjs && node --check bin/read-run.mjs && node --check bin/install-skill.mjs && node --check test/desktop.test.mjs && node --check test/submit.test.mjs && node --check test/approval.test.mjs && node --check test/interaction.test.mjs" }
}
